<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="32dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            tools:targetApi="28"
            android:fontFamily="@font/manrope_800"
            android:letterSpacing="-0.02"
            android:text="@string/scanner_title"
            android:textColor="@color/scanner_text"
            android:textSize="24sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/scanner_help"
            android:textColor="@color/scanner_text_muted"
            android:textSize="16sp" />
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/scanner_frame_background"
            android:clipToOutline="true"
            tools:targetApi="31"
            android:padding="0dp">
            <com.journeyapps.barcodescanner.DecoratedBarcodeView
                android:id="@+id/zxing_barcode_scanner"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                app:zxing_framing_rect_height="240dp"
                app:zxing_framing_rect_width="240dp"
                app:zxing_preview_scaling_strategy="centerCrop"
                app:zxing_use_texture_view="true" />
        </FrameLayout>
        <Button
            android:id="@+id/qr_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/scanner_cancel_background"
            android:fontFamily="@font/manrope_700"
            android:minWidth="160dp"
            android:minHeight="52dp"
            android:paddingHorizontal="24dp"
            android:text="@string/scanner_cancel"
            android:textAllCaps="false"
            android:textColor="@color/scanner_text"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
