<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:locale="es">
    <!-- Matches DarkColors in ui/theme/Color.kt; the camera is a native View, always dark. -->
    <color name="scanner_background">#0E0F0E</color>
    <color name="scanner_surface">#171917</color>
    <color name="scanner_text">#F2F4EE</color>
    <color name="scanner_text_muted">#B3B8AD</color>
    <color name="scanner_outline">#6B716A</color>
    <color name="scanner_primary">#CBDDB0</color>
    <!-- Overrides of zxing-android-embedded resources: scan frame accent and mask. -->
    <color name="zxing_viewfinder_laser" tools:override="true" tools:ignore="UnusedResources">#B8D8FF</color>
    <color name="zxing_viewfinder_mask" tools:override="true" tools:ignore="UnusedResources">#990E0F0E</color>
    <color name="zxing_possible_result_points" tools:override="true" tools:ignore="UnusedResources">#80B8D8FF</color>
    <color name="zxing_status_text" tools:override="true" tools:ignore="UnusedResources">#B3B8AD</color>
    <style name="Theme.YouSong.Scanner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/scanner_background</item>
        <item name="android:colorAccent">@color/scanner_primary</item>
        <item name="android:navigationBarColor">@color/scanner_background</item>
        <item name="android:statusBarColor">@color/scanner_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/manrope_400</item>
    </style>
    <string name="scanner_title">Escanea el QR del local</string>
    <string name="scanner_help">Lo encuentras en tu mesa o en la barra. Ponlo dentro del recuadro y lo leemos al instante.</string>
    <string name="scanner_cancel">Cancelar</string>
    <string name="scanner_prompt">Apunta al QR del local</string>
</resources>
